# PostgreSQL
DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Hibernate behavior
# Use update temporarily for local development.
# Use validate after Flyway migrations are introduced.
DDL_AUTO=update
SHOW_SQL=false
FORMAT_SQL=false

# JWT
# Replace with a long, random secret in the real environment.
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET
JWT_EXPIRATION_MS=3600000

# Razorpay backend credentials
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Backend runtime and allowed frontend origin
PORT=8080
FRONTEND_URL=http://localhost:5173

# React/Vite public configuration
VITE_API_BASE_URL=http://localhost:8080