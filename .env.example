# ================================================================
# CUTIE COLLECTION - SAFE ENVIRONMENT VARIABLE TEMPLATE
# ================================================================
# Copy the variables you need into your local environment or deployment
# platform settings. Never put real secrets in this example file.

# PostgreSQL / Neon database
DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# JWT authentication
# Use a long, random value in the real environment.
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET
JWT_EXPIRATION_MS=3600000

# Razorpay backend credentials
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Allowed frontend origin for backend CORS
FRONTEND_URL=http://localhost:5173

# React/Vite public configuration
# This is not a secret. Use it in the frontend environment only.
VITE_API_BASE_URL=http://localhost:8080
